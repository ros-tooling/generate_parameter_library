<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>generate_parameter_library</name>
  <version>1.4.0</version>
  <description>CMake to generate ROS parameter library.</description>
  <maintainer email="bence.magyar.robotics@gmail.com">bmagyar</maintainer>
  <maintainer email="christoph.froehlich@ait.ac.at">christophfroehlich</maintainer>
  <maintainer email="nathanbrooks@picknik.ai">Nathan Brooks</maintainer>
  <maintainer email="shaurya.kumar@picknik.ai">Shaurya Kumar</maintainer>
  <maintainer email="paul.gesel@picknik.ai">Paul Gesel</maintainer>
  <license>BSD-3-Clause</license>
  <author email="paul.gesel@picknik.ai">Paul Gesel</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <buildtool_export_depend>generate_parameter_library_py</buildtool_export_depend>

  <!-- Packages that use generate_parameter_library as a plain <depend> keep getting
       the runtime packages; see the README for keeping the generator off the target. -->
  <build_export_depend>generate_parameter_library_runtime_cpp</build_export_depend>
  <exec_depend>generate_parameter_library_runtime_cpp</exec_depend>
  <exec_depend>generate_parameter_library_runtime_py</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rosdoc2>rosdoc2.yaml</rosdoc2>
  </export>
</package>
