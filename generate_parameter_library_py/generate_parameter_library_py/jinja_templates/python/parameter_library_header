# Module functions rather than struct methods, so that no field or map key of a
# definition can collide with them.
def _map_entry_names(struct):
    """Return the keys of the map entries of a generated struct."""
    map_type = next(
        value for name, value in vars(type(struct)).items() if name.endswith('__map_type')
    )
    return [name for name, value in vars(struct).items() if isinstance(value, map_type)]


def _map_remove_entry(struct, name):
    vars(struct).pop(name, None)


